{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity Candidate Output",
  "type": "object",
  "required": ["generated_at", "mode", "count", "candidates"],
  "properties": {
    "generated_at": {
      "type": "string",
      "description": "ISO timestamp generated by the scanner."
    },
    "mode": {
      "type": "string",
      "enum": ["offline_backtest_scan", "live_scan"]
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostics": {
      "type": "object",
      "description": "Live scan diagnostics used to explain empty results.",
      "properties": {
        "fetched_events": { "type": "integer" },
        "after_title_filter": { "type": "integer" },
        "within_time_window": { "type": ["integer", "null"] },
        "watchlist_matches": { "type": ["integer", "null"] },
        "final_events": { "type": "integer" },
        "candidate_count": { "type": "integer" },
        "title_filter": { "type": "string" },
        "watchlist_enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_title",
          "market_title",
          "phenomenon_tags",
          "recommended_strategy",
          "route_strategy",
          "opportunity_score",
          "metrics"
        ],
        "properties": {
          "event_title": { "type": "string" },
          "event_slug": { "type": "string" },
          "market_title": { "type": "string" },
          "market_slug": { "type": "string" },
          "phenomenon_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P[0-9]_"
            },
            "description": "Market phenomena detected by the discovery layer, e.g. P1/P2/P5."
          },
          "recommended_strategy": {
            "type": "string",
            "pattern": "^S[0-9]_",
            "description": "Strategy layer recommendation, e.g. S1/S2."
          },
          "recommended_strategy_detail": { "type": "string" },
          "route_strategy": {
            "type": "string",
            "pattern": "^S[0-9]_"
          },
          "strategy_maturity": {
            "type": "string",
            "enum": [
              "L0_OBSERVE",
              "L1_ADVISORY",
              "L2_SIMULATION",
              "L2_EXPERIMENTAL",
              "L3_SMALL_LIVE",
              "L4_STABLE_LIVE"
            ]
          },
          "execution_mode": { "type": "string" },
          "required_execution_protection": {
            "type": "string",
            "description": "Execution module required after entry, usually D2_PROFIT_LOCK."
          },
          "opportunity_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "metrics": {
            "type": "object",
            "required": ["outcome", "last", "min", "max", "rebound_from_min"],
            "properties": {
              "outcome": { "type": "string" },
              "first": { "type": "number" },
              "last": { "type": "number" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "rebound_from_min": { "type": "number" },
              "crosses_50": { "type": "integer" },
              "liquidity_score": { "type": ["integer", "string"] },
              "action_recommendation": { "type": "string" },
              "phenomenon_tags": {
                "type": "array",
                "items": { "type": "string" }
              },
              "recommended_strategy": { "type": "string" },
              "route_strategy": { "type": "string" }
            },
            "additionalProperties": true
          },
          "source_file": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
