{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prediction Market Grid Trade Config",
  "type": "object",
  "required": [
    "version",
    "mode",
    "amount_mode",
    "market_slug",
    "side",
    "strategy_type",
    "match_budget",
    "cycle_budget",
    "buy_ladders",
    "sell_plan"
  ],
  "properties": {
    "version": { "type": "string" },
    "mode": { "type": "string" },
    "amount_mode": { "const": "fixed_usd" },
    "market_slug": { "type": "string", "minLength": 1 },
    "market_title": { "type": "string" },
    "side": { "type": "string", "minLength": 1 },
    "league": { "type": "string" },
    "strategy_type": {
      "enum": ["A_DEEP_REVERSAL", "B_FAVORITE_DIP", "C_DOMINANT_COMPOUNDER"]
    },
    "current_price": { "type": "number", "minimum": 0, "maximum": 1 },
    "pre_match_price": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "match_budget": { "type": "number", "exclusiveMinimum": 0 },
    "cycle_budget": { "type": "number", "exclusiveMinimum": 0 },
    "buy_ladders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["price", "amount_usd"],
        "properties": {
          "price": { "type": "number", "minimum": 0.01, "maximum": 0.99 },
          "amount_usd": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "sell_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["price", "sell_cost_basis_usd"],
        "properties": {
          "price": { "type": "number", "minimum": 0.01, "maximum": 0.99 },
          "sell_cost_basis_usd": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "lottery_cost_basis_usd": { "type": "number", "minimum": 0 },
    "profit_lock_plan": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "execution_protection" },
        "applies_to": { "type": "array", "items": { "type": "string" } },
        "trigger_min_profit_price": { "type": "number", "minimum": 0, "maximum": 1 },
        "major_lock_price": { "type": "number", "minimum": 0, "maximum": 1 },
        "final_trim_price": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_lottery_cost_basis_usd": { "type": "number", "minimum": 0 },
        "max_lottery_cost_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "trailing_protection": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["after_touch", "stop_price"],
            "properties": {
              "after_touch": { "type": "number", "minimum": 0, "maximum": 1 },
              "stop_price": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "principle": { "type": "string" }
      }
    },
    "max_cycles": { "type": "integer", "minimum": 1 },
    "stop_new_entry_below": { "type": "number", "minimum": 0, "maximum": 1 },
    "stop_new_entry_above": { "type": "number", "minimum": 0, "maximum": 1 },
    "operator_note": { "type": "string" },
    "entry_checks": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
